{
  "name": "kingdom-connect",
  "private": true,
  "version": "0.0.0",
  "description": "Kingdom Connect: member app (Expo), admin console (Next.js) and shared code.",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck && tsc -p e2e && pnpm typecheck:functions",
    "typecheck:functions": "npx -y deno@2.9.6 check --config supabase/functions/deno.json --node-modules-dir=none supabase/functions/login/index.ts supabase/functions/verify-otp/index.ts supabase/functions/resend-otp/index.ts supabase/functions/send-notification-emails/index.ts",
    "lint": "pnpm -r --if-present run lint",
    "theme": "tsx packages/shared/scripts/write-theme-css.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "member": "pnpm --filter @kingdom-connect/member start",
    "member:web": "pnpm --filter @kingdom-connect/member web",
    "admin": "pnpm --filter @kingdom-connect/admin dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:new": "supabase migration new",
    "prepare": "husky",
    "notifications": "tsx packages/shared/scripts/write-notification-copy.ts"
  },
  "devDependencies": {
    "@kingdom-connect/shared": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.0.0",
    "lucide-react": "^1.66.0",
    "postgres": "3.4.9",
    "prettier": "^3.5.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
