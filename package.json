{
  "name": "kingdom-connect",
  "private": true,
  "version": "0.0.0",
  "description": "Kingdom Connect: member app (Expo), admin console (Next.js) and shared code.",
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "theme": "tsx packages/shared/scripts/write-theme-css.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "member": "pnpm --filter @kingdom-connect/member start",
    "member:web": "pnpm --filter @kingdom-connect/member web",
    "admin": "pnpm --filter @kingdom-connect/admin dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:new": "supabase migration new",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^16.0.0",
    "lucide-react": "^1.66.0",
    "prettier": "^3.5.0",
    "supabase": "^2.122.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
